{%- liquid
  assign recommended_scroll_limit = limit | default: 8
  assign heading_text = heading | default: 'Recomendados para ti'
  assign view_all_label = view_all_label | default: ''
  assign view_all_link = view_all_link | default: ''
  assign product_cards = related_products | default: empty
  assign cards_rendered = 0
-%}

{%- if product_cards != empty -%}
  <div class="product-recommended-scroll product__info--spacing">
    <div class="d-flex between-xs middle-xs mb-12">
      <span class="h6 m-zero">{{ heading_text }}</span>
      {%- if view_all_link != blank and view_all_label != blank -%}
        <a class="btn-link recommended-scroll__view-all" href="{{ view_all_link }}">{{ view_all_label }}</a>
      {%- endif -%}
    </div>
    <div class="recommended-scroll__container scrollable scrollable-x disable-scrollbars" role="list" aria-label="{{ heading_text | escape }}">
      {%- for related_product in product_cards -%}
        {%- if related_product.id != current_product.id -%}
          {%- liquid
            assign has_available_variant = false
            for variant in related_product.variants
              if variant.available
                assign has_available_variant = true
                break
              endif
            endfor
          -%}
          {%- if has_available_variant -%}
            {%- assign cards_rendered = cards_rendered | plus: 1 -%}
            {%- if cards_rendered > recommended_scroll_limit -%}{% break %}{% endif -%}
            {%- assign card_id = 'recommended-card-' | append: related_product.id | append: '-' | append: forloop.index -%}
            {%- assign form_id = 'recommended-form-' | append: related_product.id | append: '-' | append: forloop.index -%}
            {%- assign default_variant = related_product.selected_or_first_available_variant -%}
            {%- assign default_image = default_variant.featured_media | default: related_product.featured_media | default: related_product.featured_image -%}
          
          <div class="recommended-scroll-card-wrapper" data-product-id="{{ related_product.id }}">
            <script type="application/json" class="js-recommended-variants-data">
              {
                "productId": {{ related_product.id }},
                "variants": [
                  {%- for variant in related_product.variants -%}
                    {
                      "id": {{ variant.id }},
                      "available": {{ variant.available }},
                      "image": {% if variant.featured_media %}"{{ variant.featured_media | image_url: width: 360 }}"{% else %}null{% endif %},
                      "price": {{ variant.price }},
                      "price_formatted": "{{ variant.price | money }}",
                      "compare_at_price": {% if variant.compare_at_price %}{{ variant.compare_at_price }}{% else %}null{% endif %},
                      "compare_at_price_formatted": {% if variant.compare_at_price %}"{{ variant.compare_at_price | money }}"{% else %}null{% endif %},
                      "options": [
                        {%- for option in variant.options -%}
                          {{ option | json }}{% unless forloop.last %},{% endunless %}
                        {%- endfor -%}
                      ]
                    }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ]
              }
            </script>
            <div class="recommended-scroll-card d-flex fd-column scrollable-aln-start">
              <a href="{{ related_product.url }}" class="recommended-scroll-card__link" title="{{ related_product.title | escape }}" tabindex="-1">
                <div class="recommended-scroll-card__media media-wrapper of-cover">
                  {%- liquid
                    assign img_width = 360
                    assign img_height = 360
                    if default_image.width and default_image.height
                      assign aspect_ratio = default_image.width | divided_by: default_image.height
                      if aspect_ratio > 1
                        assign img_height = 360 | divided_by: aspect_ratio | round
                      elsif aspect_ratio < 1
                        assign img_width = 360 | times: aspect_ratio | round
                      endif
                    endif
                  -%}
                  <img 
                    class="media recommended-scroll-card__image js-recommended-card-image" 
                    src="{{ default_image | image_url: width: 360 }}"
                    srcset="{{ default_image | image_url: width: 120 }} 120w, {{ default_image | image_url: width: 160 }} 160w, {{ default_image | image_url: width: 360 }} 360w"
                    sizes="(min-width: 769px) 160px, 120px"
                    alt="{{ default_image.alt | default: related_product.title }}"
                    width="{{ img_width }}"
                    height="{{ img_height }}"
                    decoding="async"
                    loading="lazy"
                    data-default-image="{{ default_image | image_url: width: 360 }}"
                    data-product-id="{{ related_product.id }}"
                  >
                </div>
              </a>
              
              <div class="recommended-scroll-card__info mt-8">
                <div class="recommended-scroll-card__price js-recommended-card-price" data-product-id="{{ related_product.id }}">
                  {%- if default_variant.compare_at_price > default_variant.price -%}
                    <span class="price-item price-item--last mt-4 mb-4 d-inline-block">{{ default_variant.price | money }}</span>
                    <s class="price-item price-item--regular color-light subtext d-inline-block ml-4">{{ default_variant.compare_at_price | money }}</s>
                  {%- else -%}
                    <span class="price-item price-item--regular price-item--last mt-4 mb-4 d-inline-block">{{ default_variant.price | money }}</span>
                  {%- endif -%}
                </div>
              </div>
              
              {%- form 'product', related_product, id: form_id, class: 'recommended-scroll-card__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input type="hidden" name="id" value="{{ default_variant.id }}" class="js-recommended-variant-id" data-product-id="{{ related_product.id }}">
                
                <div class="recommended-scroll-card__form-content">
                  {%- unless related_product.has_only_default_variant -%}
                    <div class="recommended-scroll-card__variants">
                      {%- for option in related_product.options_with_values -%}
                        {%- assign option_index = forloop.index | minus: 1 -%}
                        <div class="recommended-scroll-card__variant-select">
                          <select 
                            class="form__control recommended-scroll-card__variant-select-input js-recommended-variant-select" 
                            id="{{ form_id }}-option-{{ option_index }}"
                            name="options[{{ option.name | escape }}]"
                            form="{{ form_id }}" 
                            data-product-id="{{ related_product.id }}"
                            data-option-index="{{ option_index }}"
                          >
                            {%- for value in option.values -%}
                              {%- liquid
                                assign option_disabled = true
                                for variant in related_product.variants
                                  if variant.options[option_index] == value and variant.available
                                    assign option_disabled = false
                                    break
                                  endif
                                endfor
                              -%}
                              <option 
                                value="{{ value | escape }}"
                                {% if default_variant.options[option_index] == value %}selected{% endif %}
                                {% if option_disabled %}disabled{% endif %}
                              >
                                {{ value }}{% if option_disabled %} - {{ 'products.product.unavailable' | t }}{% endif %}
                              </option>
                            {%- endfor -%}
                          </select>
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <div class="recommended-scroll-card__variants-placeholder"></div>
                  {%- endunless -%}
                  
                  <button 
                    type="submit" 
                    name="add" 
                    class="recommended-scroll-card__add-to-cart btn btn-secondary btn-small w-100 js-recommended-add-to-cart"
                    data-product-id="{{ related_product.id }}"
                    {% if default_variant.available == false %}disabled{% endif %}
                  >
                    {%- if default_variant.available == false -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- else -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- endif -%}
                  </button>
                </div>
              {%- endform -%}
            </div>
          </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- unless product_recommended_scroll_styles_loaded -%}
    {%- assign product_recommended_scroll_styles_loaded = true -%}
    <style>
      .product-recommended-scroll {
        margin-top: calc(var(--spacing) * 1.5);
        padding-left: 16px;
        padding-right: 16px;
      }
      @media (min-width: 769px) {
        .product-recommended-scroll {
          padding-left: 0;
          padding-right: 0;
        }
      }
      .recommended-scroll-card-wrapper {
        min-width: 120px;
        scroll-snap-align: start;
        margin-right: calc(var(--spacing));
      }
      .recommended-scroll-card {
        gap: 8px;
        min-width: 100%;
        display: flex;
        flex-direction: column;
      }
      .recommended-scroll-card__link {
        text-decoration: none;
        display: block;
      }
      .recommended-scroll-card__media {
        border-radius: 12px;
        overflow: hidden;
        aspect-ratio: 1/1;
        background-color: rgba(var(--color-normal-text-rgb), .06);
        position: relative;
      }
      .recommended-scroll-card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: opacity 0.3s ease;
      }
      .recommended-scroll-card__info {
        width: 100%;
      }
      .recommended-scroll-card__title {
        display: block;
        text-align: center;
        color: inherit;
        font-size: 12px;
        line-height: 1.4;
        font-weight: 500;
        margin: 0;
      }
      .recommended-scroll-card__price {
        font-size: 10px;
        line-height: 1.4;
        text-align: center;
      }
      .recommended-scroll-card__price .price-item {
        display: inline-block;
      }

      .recommended-scroll-card__price .price-item--regular {
        font-size: 11px;
      }

      .recommended-scroll-card__price .price-item--last {
        font-size: 11px;
      }
      .recommended-scroll-card__form {
        width: 100%;
        display: flex;
        flex-direction: column;
        flex: 1;
      }
      .recommended-scroll-card__form-content {
        display: flex;
        flex-direction: column;
        flex: 1;
      }
      .recommended-scroll-card__variants {
        width: 100%;
        min-height: 60px;
      }
      .recommended-scroll-card__variants-placeholder {
        min-height: 60px;
        width: 100%;
      }
      .recommended-scroll-card__variant-select {
        width: 100%;
      }
      .recommended-scroll-card__variant-label {
        font-size: 0.9375rem;
        font-weight: 500;
        line-height: 1.4;
      }
      .recommended-scroll-card__variant-select-input {
        width: 100%;
        padding: 10px 12px;
        font-size: 12px;
        line-height: 1.4;
        border: 1px solid rgba(var(--color-normal-text-rgb), 0.2);
        border-radius: 4px;
        background-color: var(--color-background);
        text-align: center;
      }
      .recommended-scroll-card__variant-select-input option {
        text-align: center;
      }
      .recommended-scroll-card__add-to-cart {
        font-size: 1.2rem;
        padding: 12px;
        line-height: 1.4;
        margin-top: auto;
      }
      .recommended-scroll-card__add-to-cart:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
      .recommended-scroll__container {
        display: flex;
        gap: calc(var(--spacing));
        padding-bottom: 8px;
        scroll-snap-type: x proximity;
        overflow-y: hidden;
        scrollbar-width: thin;
        scrollbar-color: #000000 #f5f5f5;
      }
      .recommended-scroll__container::-webkit-scrollbar {
        height: 4px;
      }
      .recommended-scroll__container::-webkit-scrollbar-track {
        background: #f5f5f5;
        border-radius: 999px;
      }
      .recommended-scroll__container::-webkit-scrollbar-thumb {
        background: #000000;
        border-radius: 999px;
      }
      .recommended-scroll__container::-webkit-scrollbar-button {
        display: none;
      }
      .recommended-scroll__container::-webkit-scrollbar-corner {
        display: none;
      }
      @media (min-width: 769px) {
        .recommended-scroll-card-wrapper {
          min-width: 200px;
        }
      }
    </style>
    
    <script>
      (function() {
        if (!document.querySelector('.recommended-scroll-card-wrapper')) return;
        
        // Store variant data for each product
        const variantData = {};
        
        // Get main product variant selector
        const getMainProductSelectedOptions = (changedSelect = null) => {
          const mainProductForm = document.querySelector('[data-type="add-to-cart-form"]');
          if (!mainProductForm) return null;
          
          // Helper function to filter out recommended product selects
          const isMainProductSelect = (element) => {
            // Exclude if it's a recommended product select
            if (element.classList.contains('js-recommended-variant-select')) return false;
            if (element.closest('.recommended-scroll-card-wrapper')) return false;
            if (element.id && element.id.includes('recommended-form-')) return false;
            if (element.dataset.productId) return false; // Recommended products have data-product-id
            return true;
          };
          
          // Try to get from variant selects/radios first (most reliable)
          // Search in the entire document but within the product section context
          const productSection = mainProductForm.closest('[data-section]') || document;
          const variantSelectsContainer = productSection.querySelector('sht-variant-selects, sht-variant-radios');
          
          // Try multiple search strategies
          let mainProductSelects = [];
          
          // Strategy 1: Search within custom elements
          if (variantSelectsContainer) {
            const found = variantSelectsContainer.querySelectorAll('.js-variant-select-item, .js-variant-radio-item:checked, select[name*="option"], input[type="radio"][name*="option"]:checked');
            mainProductSelects = Array.from(found).filter(isMainProductSelect);
          }
          
          // Strategy 2: Search in the entire product section, but exclude recommended products area
          if (mainProductSelects.length === 0) {
            const found = productSection.querySelectorAll('.js-variant-select-item, .js-variant-radio-item:checked, select[name*="option"], input[type="radio"][name*="option"]:checked');
            mainProductSelects = Array.from(found).filter(isMainProductSelect);
          }
          
          // Strategy 3: Search in the entire document (fallback)
          if (mainProductSelects.length === 0) {
            const found = document.querySelectorAll('.js-variant-select-item, .js-variant-radio-item:checked, select[name*="option"], input[type="radio"][name*="option"]:checked');
            mainProductSelects = Array.from(found).filter(isMainProductSelect);
          }
          
          // If we have a specific select that changed, use it directly
          if (changedSelect && (changedSelect.tagName === 'SELECT' || (changedSelect.tagName === 'INPUT' && changedSelect.type === 'radio'))) {
            // Make sure it's not a recommended product select
            if (!isMainProductSelect(changedSelect)) {
              return null;
            }
            const selectedOptions = [];
            
            // Get all selects/radios for this product to build the full options array
            const allSelects = Array.from(productSection.querySelectorAll('.js-variant-select-item, select[name*="option"]'));
            const allRadios = Array.from(productSection.querySelectorAll('.js-variant-radio-item, input[type="radio"][name*="option"]'));
            
            // Filter to only main product selects
            const filteredSelects = allSelects.filter(isMainProductSelect);
            const filteredRadios = allRadios.filter(isMainProductSelect);
            
            // Combine and sort by DOM order or option index
            const allVariantInputs = [...filteredSelects, ...filteredRadios].sort((a, b) => {
              const aIndex = parseInt(a.dataset.optionIndex || a.closest('[data-option-index]')?.dataset.optionIndex || '0');
              const bIndex = parseInt(b.dataset.optionIndex || b.closest('[data-option-index]')?.dataset.optionIndex || '0');
              if (aIndex !== bIndex) return aIndex - bIndex;
              // If same index, maintain DOM order
              const position = a.compareDocumentPosition(b);
              return position & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1;
            });
            
            allVariantInputs.forEach((input, idx) => {
              let value = null;
              if (input.tagName === 'SELECT') {
                value = input.value;
              } else if (input.tagName === 'INPUT' && input.type === 'radio') {
                if (input.checked) {
                  value = input.value;
                }
              }
              if (value) {
                selectedOptions.push(value);
              }
            });
            
            if (selectedOptions.length > 0) {
              return selectedOptions;
            }
          }
          
          if (mainProductSelects.length > 0) {
            const selectedOptions = [];
            // Sort selects by their option index if available, or by DOM position
            const sortedSelects = Array.from(mainProductSelects).sort((a, b) => {
              // Try to get option index from data attribute
              let aIndex = parseInt(a.dataset.optionIndex || a.closest('[data-option-index]')?.dataset.optionIndex || '');
              let bIndex = parseInt(b.dataset.optionIndex || b.closest('[data-option-index]')?.dataset.optionIndex || '');
              
              // If no data-option-index, try to extract from name attribute (e.g., "options[Dispositivo]" -> index 0)
              if (isNaN(aIndex) && a.name) {
                const nameMatch = a.name.match(/options\[([^\]]+)\]/);
                if (nameMatch) {
                  // Find position in options_with_values by comparing with all selects
                  const allSelects = Array.from(mainProductSelects);
                  aIndex = allSelects.indexOf(a);
                }
              }
              if (isNaN(bIndex) && b.name) {
                const nameMatch = b.name.match(/options\[([^\]]+)\]/);
                if (nameMatch) {
                  const allSelects = Array.from(mainProductSelects);
                  bIndex = allSelects.indexOf(b);
                }
              }
              
              // Fallback to DOM position
              if (isNaN(aIndex)) aIndex = Array.from(a.parentElement?.children || []).indexOf(a);
              if (isNaN(bIndex)) bIndex = Array.from(b.parentElement?.children || []).indexOf(b);
              
              return aIndex - bIndex;
            });
            
            sortedSelects.forEach((select, idx) => {
              let optionValue = null;
              if (select.tagName === 'SELECT') {
                optionValue = select.value;
                if (optionValue) {
                  selectedOptions.push(optionValue);
                }
              } else if (select.tagName === 'INPUT' && select.type === 'radio') {
                if (select.checked) {
                  optionValue = select.value;
                  if (optionValue) {
                    selectedOptions.push(optionValue);
                  }
                }
              }
            });
            
            if (selectedOptions.length > 0) {
              return selectedOptions;
            }
          }
          
          // Fallback: try to get from variant ID and find options
          const variantIdInput = mainProductForm.querySelector('input[name="id"]');
          if (variantIdInput && variantIdInput.value) {
            const variantId = parseInt(variantIdInput.value);
            // Try to find variant data in the page
            // First, try to find script within variant container
            let variantScripts = [];
            if (variantSelectsContainer) {
              variantScripts = Array.from(variantSelectsContainer.querySelectorAll('script[type="application/json"]'));
            }
            // If not found, search in product section
            if (variantScripts.length === 0) {
              variantScripts = Array.from(productSection.querySelectorAll('script[type="application/json"]'));
            }
            // If still not found, search in entire document
            if (variantScripts.length === 0) {
              variantScripts = Array.from(document.querySelectorAll('script[type="application/json"]'));
            }
            for (let script of variantScripts) {
              try {
                const data = JSON.parse(script.textContent);
                
                // Check if it's an array of variants
                if (Array.isArray(data)) {
                  const variant = data.find(v => {
                    const vId = parseInt(v.id) || v.id;
                    const targetId = parseInt(variantId) || variantId;
                    return vId == targetId;
                  });
                  if (variant) {
                    // Try different possible property names for options
                    if (variant.options && Array.isArray(variant.options)) {
                      return variant.options;
                    } else if (variant.option1 || variant.option2 || variant.option3) {
                      // Build options array from option1, option2, option3 (Shopify standard format)
                      const options = [];
                      if (variant.option1) options.push(variant.option1);
                      if (variant.option2) options.push(variant.option2);
                      if (variant.option3) options.push(variant.option3);
                      return options.length > 0 ? options : null;
                    }
                  }
                } else if (data.variants && Array.isArray(data.variants)) {
                  // Check if data has a variants property
                  const variant = data.variants.find(v => {
                    const vId = parseInt(v.id) || v.id;
                    const targetId = parseInt(variantId) || variantId;
                    return vId == targetId;
                  });
                  if (variant) {
                    if (variant.options && Array.isArray(variant.options)) {
                      return variant.options;
                    } else if (variant.option1 || variant.option2 || variant.option3) {
                      const options = [];
                      if (variant.option1) options.push(variant.option1);
                      if (variant.option2) options.push(variant.option2);
                      if (variant.option3) options.push(variant.option3);
                      return options.length > 0 ? options : null;
                    }
                  }
                }
              } catch (e) {
                // Silently ignore parsing errors
              }
            }
          }
          
          return null;
        };
        
        // Initialize variant data from JSON scripts
        document.querySelectorAll('.js-recommended-variants-data').forEach(script => {
          try {
            const data = JSON.parse(script.textContent);
            variantData[data.productId] = data.variants;
          } catch (e) {
            console.error('Error parsing variant data:', e);
          }
        });
        
        // Sync recommended products with main product variant
        const syncRecommendedProductsWithMain = (changedSelect = null) => {
          const mainProductOptions = getMainProductSelectedOptions(changedSelect);
          console.log('[DEBUG] Main product options:', mainProductOptions);
          if (!mainProductOptions || mainProductOptions.length === 0) {
            return;
          }
          
          const recommendedCards = document.querySelectorAll('.recommended-scroll-card-wrapper');
          
          recommendedCards.forEach((card, cardIdx) => {
            const productId = parseInt(card.dataset.productId);
            const variants = variantData[productId];
            if (!variants || variants.length === 0) {
              return;
            }
            
            // Find matching variant in recommended product
            // Match if the recommended variant CONTAINS the main product variant (flexible matching)
            // Example: Main "iPhone 14 Pro" matches Recommended "iPhone 13 Pro Max / 14 Pro"
            const matchingVariant = variants.find((variant, variantIdx) => {
              // Construct options array from option1, option2, option3 if options doesn't exist
              let currentVariantOptions = variant.options;
              if (!currentVariantOptions && (variant.option1 || variant.option2 || variant.option3)) {
                currentVariantOptions = [];
                if (variant.option1) currentVariantOptions.push(variant.option1);
                if (variant.option2) currentVariantOptions.push(variant.option2);
                if (variant.option3) currentVariantOptions.push(variant.option3);
              }
              
              if (!currentVariantOptions || currentVariantOptions.length === 0) {
                return false;
              }
              
              // Extract model numbers from a string (e.g., "14 Pro" from "iPhone 14 Pro")
              // This allows matching "iPhone 14 Pro" with "iPhone 13 Pro Max / 14 Pro"
              const extractModelNumbers = (str) => {
                const models = [];
                
                // First, extract full patterns with suffixes: "15 Pro", "14 Pro Max", "16 Plus"
                const fullPattern = /(\d+\s+(?:pro|plus|max)(?:\s+(?:max|plus))?)/gi;
                let match;
                while ((match = fullPattern.exec(str)) !== null) {
                  models.push(match[1].toLowerCase().trim());
                }
                
                // Also extract standalone numbers (but only if no full matches found)
                if (models.length === 0) {
                  const numberPattern = /(\d+)/g;
                  while ((match = numberPattern.exec(str)) !== null) {
                    models.push(match[1].toLowerCase().trim());
                  }
                }
                
                return models;
              };
              
              // Compare ALL options from main product with ALL options from recommended variant
              // This handles cases where:
              // - Main: "iPhone 14 Pro" (1 option)
              // - Recommended: "Transparente" + "iPhone 14 Pro" (2 options)
              // We need to find if ANY recommended option matches ANY main product option
              
              let matches = false;
              
              // For each main product option, check if it matches any recommended variant option
              for (let mainIdx = 0; mainIdx < mainProductOptions.length; mainIdx++) {
                const mainOpt = mainProductOptions[mainIdx];
                if (!mainOpt) continue;
                
                const mainOptStr = mainOpt.toString().trim().toLowerCase();
                const mainModels = extractModelNumbers(mainOptStr);
                
                // Check if this main option matches any recommended option
                for (let recIdx = 0; recIdx < currentVariantOptions.length; recIdx++) {
                  const recommendedOpt = currentVariantOptions[recIdx];
                  if (!recommendedOpt) continue;
                  
                  const recommendedOptStr = recommendedOpt.toString().trim().toLowerCase();
                  const recommendedModels = extractModelNumbers(recommendedOptStr);
                  
                  // Strategy 1: Compare extracted model numbers (with suffix awareness)
                  if (mainModels.length > 0 && recommendedModels.length > 0) {
                    const modelMatch = mainModels.some(mainModel => {
                      return recommendedModels.some(recModel => {
                        // Check if main model has a suffix (pro, plus, max)
                        const mainHasSuffix = /\s*(pro|plus|max)/i.test(mainModel);
                        const recHasSuffix = /\s*(pro|plus|max)/i.test(recModel);
                        
                        // Exact match
                        if (recModel === mainModel) {
                          return true;
                        }
                        
                        // If main model has a suffix (e.g., "15 pro"), require that recommended also contains that suffix
                        // This prevents "15 Pro" from matching "15"
                        if (mainHasSuffix) {
                          // Main is "15 pro" - only match if recommended contains "15 pro" (not just "15")
                          // Check if recommended model includes the full main model (number + suffix)
                          return recModel.includes(mainModel);
                        }
                        
                        // If main model is just a number (e.g., "15"), it can match "15" or "15 pro"
                        // But "15 pro" should NOT match "15" (handled above)
                        if (!mainHasSuffix) {
                          // Main is just "15" - can match "15" or "15 pro" in recommended
                          return recModel === mainModel || recModel.startsWith(mainModel + ' ');
                        }
                        
                        return false;
                      });
                    });
                    if (modelMatch) {
                      matches = true;
                      console.log(`[DEBUG] Variant ${variantIdx} MATCHED - model numbers:`, {
                        main: mainOptStr,
                        recommended: recommendedOptStr,
                        mainModels: mainModels,
                        recommendedModels: recommendedModels
                      });
                      break;
                    }
                  }
                  
                  // Strategy 2: Check if one contains the other as substring (strict)
                  // Check if recommended contains main (e.g., "13 Pro Max / 14 Pro" contains "14 Pro")
                  if (recommendedOptStr.includes(mainOptStr)) {
                    // CRITICAL: If main has a suffix (pro, plus, max), ensure recommended also has it
                    // This prevents "15 Pro" from matching "15"
                    const mainHasSuffix = /\s*(pro|plus|max)\s*$/i.test(mainOptStr);
                    if (mainHasSuffix) {
                      // Main is "15 pro" - verify that recommended actually contains "15 pro" (not just "15")
                      // Check if the match is complete (not partial)
                      const matchIndex = recommendedOptStr.indexOf(mainOptStr);
                      const beforeMatch = recommendedOptStr.substring(0, matchIndex);
                      const afterMatch = recommendedOptStr.substring(matchIndex + mainOptStr.length);
                      
                      // Verify the match is at a word boundary
                      // Before should end with space/slash/dash or be empty
                      // After should start with space/slash/dash or be empty
                      const validBefore = matchIndex === 0 || /[\s\/\-]$/.test(beforeMatch);
                      const validAfter = afterMatch === '' || /^[\s\/\-]/.test(afterMatch);
                      
                      if (validBefore && validAfter) {
                        matches = true;
                        console.log(`[DEBUG] Variant ${variantIdx} MATCHED - recommended contains main with suffix:`, {
                          main: mainOptStr,
                          recommended: recommendedOptStr,
                          mainModels: mainModels,
                          recommendedModels: recommendedModels
                        });
                        break;
                      }
                    } else {
                      // Main doesn't have suffix - can match more flexibly
                      const matchIndex = recommendedOptStr.indexOf(mainOptStr);
                      const afterMatch = recommendedOptStr.substring(matchIndex + mainOptStr.length);
                      if (matchIndex >= 0 && (afterMatch === '' || /^[\s\/\-]/.test(afterMatch))) {
                        matches = true;
                        console.log(`[DEBUG] Variant ${variantIdx} MATCHED - recommended contains main:`, {
                          main: mainOptStr,
                          recommended: recommendedOptStr
                        });
                        break;
                      }
                    }
                  }
                  
                  // Also check if main contains recommended (for reverse cases, but be strict)
                  // Only allow if recommended is longer (to avoid "15 Pro" matching "15")
                  if (mainOptStr.includes(recommendedOptStr)) {
                    const recommendedHasSuffix = /\s*(pro|plus|max)\s*$/i.test(recommendedOptStr);
                    const mainHasSuffix = /\s*(pro|plus|max)\s*$/i.test(mainOptStr);
                    
                    // If recommended has suffix, main must also have it (or contain it)
                    if (recommendedHasSuffix && !mainHasSuffix) {
                      // Recommended is "15 Pro" but main is "15" - don't match
                      // This prevents "15" from matching "15 Pro"
                    } else if (recommendedOptStr.length > 5) {
                      matches = true;
                      console.log(`[DEBUG] Variant ${variantIdx} MATCHED - main contains recommended:`, {
                        main: mainOptStr,
                        recommended: recommendedOptStr
                      });
                      break;
                    }
                  }
                  
                  // Strategy 3: Exact match
                  if (recommendedOptStr === mainOptStr) {
                    matches = true;
                    console.log(`[DEBUG] Variant ${variantIdx} MATCHED - exact match:`, {
                      main: mainOptStr,
                      recommended: recommendedOptStr
                    });
                    break;
                  }
                }
                
                if (matches) break;
              }
              
              if (!matches) {
                console.log(`[DEBUG] Variant ${variantIdx} NO MATCH - options:`, currentVariantOptions);
              }
              return matches;
            });
            
            if (matchingVariant && matchingVariant.available) {
              // Construct options array if needed
              let variantOptions = matchingVariant.options;
              if (!variantOptions && (matchingVariant.option1 || matchingVariant.option2 || matchingVariant.option3)) {
                variantOptions = [];
                if (matchingVariant.option1) variantOptions.push(matchingVariant.option1);
                if (matchingVariant.option2) variantOptions.push(matchingVariant.option2);
                if (matchingVariant.option3) variantOptions.push(matchingVariant.option3);
              }
              
              // Update selects in recommended product
              // Update ALL selects with ALL options from the matching variant
              // This ensures products with multiple options (e.g., "Transparente" + "15 Pro") update correctly
              const selects = card.querySelectorAll('.js-recommended-variant-select');
              console.log(`[DEBUG] Card ${cardIdx + 1} - Updating ${selects.length} selects with variant options:`, variantOptions);
              
              // Update each select with the corresponding option from the matching variant
              selects.forEach((select, selectIdx) => {
                // Get the option index for this select (from data attribute or use index)
                const optionIndex = parseInt(select.dataset.optionIndex || selectIdx);
                
                // Get the corresponding option value from the matching variant
                if (variantOptions && variantOptions[optionIndex]) {
                  const optionValue = variantOptions[optionIndex].toString().trim();
                  
                  // Find and select matching option in the select
                  const options = select.querySelectorAll('option');
                  let found = false;
                  options.forEach(opt => {
                    if (!found && opt.value && !opt.disabled) {
                      const optValue = opt.value.toString().trim();
                      const targetValue = optionValue;
                      
                      // Case-insensitive comparison
                      if (optValue.toLowerCase() === targetValue.toLowerCase()) {
                        if (select.value !== opt.value) {
                          console.log(`[DEBUG] Card ${cardIdx + 1}, select ${selectIdx} -> "${opt.value}"`);
                          select.value = opt.value;
                          // Trigger change event to update image, price, etc.
                          // Use a small delay to ensure all selects are updated before triggering events
                          setTimeout(() => {
                            select.dispatchEvent(new Event('change', { bubbles: true }));
                          }, selectIdx * 10); // Stagger events slightly
                        }
                        found = true;
                      }
                    }
                  });
                  
                  if (!found) {
                    console.log(`[DEBUG] Card ${cardIdx + 1}, select ${selectIdx} - Could not find option "${optionValue}"`);
                  }
                }
              });
            } else {
              console.log(`[DEBUG] Card ${cardIdx + 1} - No matching variant or not available`);
            }
          });
        };
        
        // Listen for changes in main product variant ONLY
        const mainProductForm = document.querySelector('[data-type="add-to-cart-form"]');
        if (mainProductForm) {
          // Listen to variant selects/radios changes within main product form ONLY
          mainProductForm.addEventListener('change', (e) => {
            // Only sync if it's a main product variant selector (not recommended products)
            if (e.target.matches('.js-variant-select-item, .js-variant-radio-item') && !e.target.classList.contains('js-recommended-variant-select')) {
              setTimeout(() => syncRecommendedProductsWithMain(e.target), 200);
            }
          });
          
          // Listen to custom elements for variant changes
          const variantRadios = document.querySelector('sht-variant-radios');
          const variantSelects = document.querySelector('sht-variant-selects');
          
          if (variantRadios) {
            variantRadios.addEventListener('change', () => {
              setTimeout(syncRecommendedProductsWithMain, 200);
            });
          }
          
          if (variantSelects) {
            variantSelects.addEventListener('change', () => {
              setTimeout(syncRecommendedProductsWithMain, 200);
            });
          }
        }
        
        // Initial sync on page load
        setTimeout(() => {
          syncRecommendedProductsWithMain();
        }, 500);
        
        // Handle variant selection change in recommended products
        // This does NOT trigger any sync - it only updates the recommended product itself
        document.addEventListener('change', function(e) {
          if (!e.target.classList.contains('js-recommended-variant-select')) return;
          
          const select = e.target;
          const productId = parseInt(select.dataset.productId);
          const card = select.closest('.recommended-scroll-card-wrapper');
          const form = card.querySelector('form');
          const variantIdInput = form.querySelector('.js-recommended-variant-id');
          const image = card.querySelector('.js-recommended-card-image');
          const addToCartBtn = card.querySelector('.js-recommended-add-to-cart');
          
          // Get all selected options
          const selectedOptions = [];
          card.querySelectorAll('.js-recommended-variant-select').forEach(s => {
            selectedOptions.push(s.value);
          });
          
          // Find matching variant
          const variants = variantData[productId];
          let matchedVariant = null;
          
          if (variants && variants.length > 0) {
            matchedVariant = variants.find(variant => {
              if (!variant.options || variant.options.length !== selectedOptions.length) return false;
              return variant.options.every((opt, idx) => opt === selectedOptions[idx]);
            });
          }
          
          if (matchedVariant) {
            // Update variant ID
            variantIdInput.value = matchedVariant.id;
            
            // Update image if variant has a different image
            if (matchedVariant.image && image) {
              const currentSrc = image.src.split('?')[0];
              const newImageSrc = matchedVariant.image.split('?')[0];
              if (currentSrc !== newImageSrc) {
                image.style.opacity = '0';
                setTimeout(() => {
                  image.src = matchedVariant.image;
                  const baseUrl = matchedVariant.image;
                  const url120 = baseUrl.replace(/width=\d+/i, 'width=120').replace(/_(\d+)x(\d+)/i, '_120x120');
                  const url160 = baseUrl.replace(/width=\d+/i, 'width=160').replace(/_(\d+)x(\d+)/i, '_160x160');
                  image.srcset = url120 + ' 120w, ' + url160 + ' 160w, ' + baseUrl + ' 360w';
                  if (!image.width) image.width = 360;
                  if (!image.height) image.height = 360;
                  image.style.opacity = '1';
                }, 150);
              }
            }
            
            // Update price
            const priceElement = card.querySelector('.js-recommended-card-price');
            if (priceElement && matchedVariant.price_formatted) {
              const priceHtml = matchedVariant.compare_at_price && matchedVariant.compare_at_price > matchedVariant.price
                ? `<span class="price-item price-item--last mt-4 mb-4 d-inline-block">${matchedVariant.price_formatted}</span><s class="price-item price-item--regular color-light subtext d-inline-block ml-4">${matchedVariant.compare_at_price_formatted}</s>`
                : `<span class="price-item price-item--regular price-item--last mt-4 mb-4 d-inline-block">${matchedVariant.price_formatted}</span>`;
              priceElement.innerHTML = priceHtml;
            }
            
            // Update add to cart button
            if (addToCartBtn) {
              if (matchedVariant.available) {
                addToCartBtn.disabled = false;
                addToCartBtn.textContent = addToCartBtn.dataset.addToCartText || '{{ 'products.product.add_to_cart' | t }}';
              } else {
                addToCartBtn.disabled = true;
                addToCartBtn.textContent = addToCartBtn.dataset.soldOutText || '{{ 'products.product.sold_out' | t }}';
              }
            }
          }
        });
        
        // Store button text in data attributes for later use
        document.querySelectorAll('.js-recommended-add-to-cart').forEach(btn => {
          if (!btn.dataset.addToCartText) {
            btn.dataset.addToCartText = btn.textContent.trim();
          }
          if (!btn.dataset.soldOutText) {
            btn.dataset.soldOutText = '{{ 'products.product.sold_out' | t }}';
          }
        });
      })();
    </script>
  {%- endunless -%}
{%- endif -%}
